# =============================================================================
# Production environment for the preview deployment — copy to `.env` AT THE
# REPO ROOT (not `app/.env`) and fill in real values.
#
#   cp .env.production.example .env && chmod 600 .env
#
# One file, two jobs, which is why it lives at the root:
#   1. Compose reads the project `.env` for `${VAR}` substitution — that is how
#      COMPOSE_FILE, POSTGRES_PASSWORD, NEO4J_PASSWORD and APP_DOMAIN reach
#      docker-compose.prod.yaml.
#   2. The `app` service loads the same file as its runtime `env_file`, so
#      everything the server reads is here too.
#
# `.env` is gitignored (`**/.env`). It is the most sensitive file on the box.
#
# ⚠️  BACK UP `AUTH_SESSION_SECRET` AND `TOKEN_ENCRYPTION_KEY` SOMEWHERE THAT IS
#     NOT THIS VM AND NOT THE VM'S BACKUPS. `scripts/backup-preview.sh`
#     deliberately does not copy this file: a backup that carries both the
#     ciphertext and its key protects nothing. But the converse trap is real —
#     restore the database onto a rebuilt VM without these two values and the
#     per-user Microsoft token cache is undecryptable. Put them in a password
#     manager or Key Vault today, before the first sign-in.
#
# Full runbook: docs/PREVIEW.md · VM shape: docs/deployment/azure-vm.md
# =============================================================================

# -----------------------------------------------------------------------------
# Compose wiring — what makes the bring-up a bare `docker compose up -d --build`
# -----------------------------------------------------------------------------

# Base stack + production overlay. Setting this also stops Compose auto-loading
# docker-compose.override.yml (the laptop-only arm64 redis hack).
COMPOSE_FILE=docker-compose.yaml:docker-compose.prod.yaml

# `app` is the profile the app container and Caddy both declare; without it the
# data tier comes up and nothing serves.
COMPOSE_PROFILES=app

# -----------------------------------------------------------------------------
# Public hostname and TLS — read by Caddy (configs/Caddyfile)
# -----------------------------------------------------------------------------

# Public FQDN of the preview. Must already resolve to this VM's public IP
# before first boot, or Let's Encrypt cannot complete the challenge.
APP_DOMAIN='preview.example.com'

# Mailbox Let's Encrypt sends expiry/problem notices to. A real, monitored one.
ACME_EMAIL='ops@example.com'

# -----------------------------------------------------------------------------
# Data-tier credentials — replace the compose file's literal `password`
# -----------------------------------------------------------------------------

# Postgres superuser password. Generate: `openssl rand -base64 24`.
# Also folded into the app's DATABASE_URL by docker-compose.prod.yaml.
POSTGRES_PASSWORD=''

# Neo4j password for the `neo4j` user. Generate: `openssl rand -base64 24`.
# ⚠️  Neo4j only applies NEO4J_AUTH when initialising an EMPTY data volume.
#     Changing this after first boot does nothing — see docs/PREVIEW.md.
NEO4J_PASSWORD=''

# Redis is not passworded: it publishes on 127.0.0.1 only and is reached over
# the compose network. Set REDIS_PWD below if you add `requirepass`.

# -----------------------------------------------------------------------------
# Microsoft Entra ID — the identity source (#119). See
# docs/deployment/entra-setup.md; every value is server-side only.
# -----------------------------------------------------------------------------

# Tenant (directory) GUID — the single-tenant OIDC authority.
AZURE_TENANT_ID=''

# Application (client) id of the Entra app registration.
AZURE_CLIENT_ID=''

# Client secret VALUE (not its id), from Certificates & secrets. Note the expiry.
AZURE_CLIENT_SECRET=''

# OIDC redirect URI — MUST be registered verbatim on the app registration under
# Authentication -> Web, and MUST be the HTTPS form of your APP_DOMAIN.
AUTH_REDIRECT_URI='https://preview.example.com/api/auth/callback'

# Where Entra returns the browser after sign-out. Same host, no registration needed.
AUTH_POST_LOGOUT_REDIRECT_URI='https://preview.example.com/auth/signin'

# Optional escape hatch: a trimmed space/comma-separated delegated Graph scope
# list. Leave unset to request the full connector set. A scope requested but not
# admin-consented fails the WHOLE sign-in, not just that connector.
# AZURE_GRAPH_SCOPES='User.Read email Mail.Read'

# -----------------------------------------------------------------------------
# Application secrets
# -----------------------------------------------------------------------------

# HMAC key signing the auth cookies. Generate: `openssl rand -base64 32`.
AUTH_SESSION_SECRET=''

# AES-256-GCM key for the per-user Microsoft token cache at rest (#110).
# Generate: `openssl rand -base64 32`. Set it EXPLICITLY here rather than
# letting it HKDF-derive from AUTH_SESSION_SECRET, so the two rotate
# independently. Rotating it just forces affected users to sign in again.
TOKEN_ENCRYPTION_KEY=''

# Encryption key for the conversation store at rest.
# ⚠️  NOT MERGED — LANDS WITH THE `mknw/db-encryption-at-rest` WORK. That branch
#     has no commits yet, so this NAME IS PROVISIONAL: confirm it against the PR
#     before relying on it. Until that lands, `conversations.context` — the full
#     event stream, including verbatim tool results — is stored in PLAINTEXT
#     JSONB, and the only protection is the VM's disk encryption. Say that
#     accurately to preview users (docs/PREVIEW-WELCOME.md), do not pre-announce
#     the feature, and back this key up separately once it exists.
# DB_ENCRYPTION_KEY=''

# Access control: comma-separated email allow-list; `*@domain.com` wildcards
# supported. An account that signs in successfully but is not listed lands on
# /auth/access-denied with no session. UNSET REJECTS EVERYONE (fail-closed).
VITE_ALLOWED_EMAILS='*@dtsc.be'

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------

# Required. Anthropic is the only LLM provider — every BAML chain routes here,
# so without this key the app signs users in and then cannot answer a message.
ANTHROPIC_API_KEY=''

# Optional, and NOT an LLM-routing key: the `openrouter` Data Stash embedding
# provider only. Needed iff EMBEDDINGS_PROVIDER=openrouter.
# OPENROUTER_API_KEY=''

# --- Self-hosted inference (Verda) ------------------------------------------
# ⚠️  NOT MERGED — LANDS WITH the `mknw/verda-inference-client` work (no PR yet).
#     Leave all three unset for the preview; with the flag unset the routing is
#     unchanged and these are ignored entirely.
#
# Re-points the controller / actor / critic / synthesizer roles at the company's
# own Qwen deployment. The literal string '1', not truthiness.
# USE_VERDA_INFERENCE='1'
#
# OpenAI-compatible base URL of that deployment — MUST end in `/v1`.
# With the flag on, a missing or root-only value throws at module load rather
# than silently falling back to the provider the flag exists to avoid.
# VERDA_INFERENCE_ENDPOINT='https://<deployment-host>/<deployment-name>/v1'
#
# Bearer key for that endpoint.
# VERDA_INFERENCE_API_KEY=''

# -----------------------------------------------------------------------------
# Data Stash (document upload + retrieval)
# -----------------------------------------------------------------------------

# Route the Data Stash app path through a direct redis connection instead of the
# gateway's serial stdio pipe (~200s -> <1s for a large document ingest).
STASH_DIRECT_REDIS='1'

# Convert binary uploads (docx/odt/pptx/pdf) to markdown via the doc-convert
# sidecar so they become searchable. Unset leaves them stored but not indexed.
STASH_CONVERT_DOCS='1'

# Per-file conversion timeout in ms (default 120000).
# DOC_CONVERT_TIMEOUT_MS='120000'

# Embedding backend for chunk vectors. ⚠️  The default `local` points at a
# llama-server the compose stack does NOT provide — see docs/PREVIEW.md
# §"Known limitation: embeddings". Upload and download work regardless; only
# semantic search over uploads needs this.
# EMBEDDINGS_PROVIDER='local'
# EMBEDDINGS_LOCAL_URL='http://127.0.0.1:8090/v1'   # the /v1 suffix is required
# EMBEDDINGS_LOCAL_MODEL=''

# Direct redis connection settings. The defaults are correct for this stack
# (host supplied by compose, port 6379, no password, no TLS).
# REDIS_PORT='6379'
# REDIS_PWD=''
# REDIS_SSL='false'

# -----------------------------------------------------------------------------
# Compute sandbox
# -----------------------------------------------------------------------------

# Backend and image for agent code execution. `kg-sandbox:base` must be built on
# the VM (`docker build -t kg-sandbox:base rootfs/`) or every sandbox run fails.
# COMPUTE_BACKEND='docker'
# SANDBOX_IMAGE='kg-sandbox:base'
# DOCKER_BIN='docker'

# -----------------------------------------------------------------------------
# Warm MCP gateway connections kept in the client pool (#120). Default 4.
# -----------------------------------------------------------------------------
# MCP_GATEWAY_POOL_SIZE='4'

# =============================================================================
# Supplied by docker-compose.prod.yaml — DO NOT SET HERE
#
# Compose `environment:` beats `env_file:`, so a value written below has no
# effect and only creates a second, drifting source of truth. Listed so the
# enumeration is complete and so nobody goes looking for them:
#
#   DATABASE_URL         postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/kgagent
#   NEO4J_USER           neo4j
#   NEO4J_PASSWORD       ${NEO4J_PASSWORD} (also consumed as NEO4J_AUTH by the DB)
#   MCP_GATEWAY_URL      http://mcp-gateway:8811/mcp
#   REDIS_HOST_DIRECT    redis
#   DOC_CONVERT_URL      http://doc-convert:8000
#   EMBEDDINGS_LOCAL_URL http://host.docker.internal:8090/v1  (base compose)
#
# NOT SET, AND MUST STAY THAT WAY
#
#   VITE_DEV_BYPASS_AUTH   The dev sign-in bypass. It is gated on
#                          `import.meta.env.DEV`, which Vite replaces with
#                          `false` when the production image is built, so a
#                          prod build ignores it and warns at startup if it is
#                          present. The overlay pins it to `false` as defence in
#                          depth. Never add it here.
# =============================================================================
