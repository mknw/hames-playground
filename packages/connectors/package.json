{
  "name": "@hames/connectors",
  "version": "0.1.0",
  "description": "The connectors companion for @hames/harness-patterns — Microsoft Graph app-side tools, the Neo4j non-agentic layer, and the MCP-gateway namespace catalog, all behind injected seams.",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./neo4j": "./neo4j/index.ts",
    "./*": "./*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hames/harness-patterns": "workspace:*",
    "neo4j-driver": "^6.0.1"
  },
  "devDependencies": {
    "cytoscape": "^3.33.2",
    "seroval": "~1.5.0",
    "vitest": "^4.1.5"
  },
  "files": [
    "*.ts",
    "!vitest.config.ts",
    "neo4j",
    "app-tools",
    "graph",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
