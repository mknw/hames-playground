# Build context = app/. Everything here either does not belong in an image or
# would poison the build if it did.

# Host-installed dependencies: the wrong platform's binaries (node-pty and the
# BAML native addon are compiled per-arch), so they MUST be reinstalled inside
# the image rather than copied in.
node_modules

# Build outputs — regenerated by the builder stage.
.output
.vinxi
dist
app.config.timestamp_*.js

# Generated BAML client — regenerated from baml_src/ inside the build, which is
# the whole point of doing it there (a stale copy fails silently).
baml_client
baml_src.bak

# Secrets. The image is tenant-agnostic; config arrives at runtime via compose
# env_file / environment.
.env
.env.*

# Test + tooling noise.
coverage
.vercel
.netlify
.wrangler
.idea
.settings
.DS_Store
Thumbs.db

# Docs are not needed to build or run the server.
docs
README.md
