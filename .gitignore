# macOS
.DS_Store

# Harness debug logs
.harness-logs/

# MCP config (contains secrets — use template.mcp-config.yaml as reference)
configs/mcp-config.yaml

# Action API tokens (contains secrets — use template.action-tokens.yaml as reference)
configs/action-tokens.yaml

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
**/.venv

# neo4j db
neo4j_data/

# Graph exports. `scripts/export-neo4j.sh` writes here by default, and since the
# org-graph roster ingest that graph holds the whole staff directory — names,
# addresses, job titles — in a PUBLIC repo. Nothing but the timestamped exports
# is ignored: `README.md` and the `seed-data.cypher` fixtures stay tracked.
# The four dumps committed before this rule predate the ingest and hold no
# personal data; an ignore rule does not untrack them, so leave them or remove
# them deliberately — it is not this line's job either way.
neo4j_dumps/export-*.cypher

# n8n data
n8n_data/

# UI Solid Start Frontend
**/node_modules
**/.env
# Agent skills and subagents are source: they travel to worktrees via git, not
# via orca.yaml's copy loop. Everything else under .claude/ (settings.json,
# settings.local.json, transcripts) stays local. The `.claude/*` form is
# required — `.claude/` makes git skip the directory, so negations never apply.
.claude/*
!.claude/skills/
!.claude/agents/

# Nix direnv
.direnv/

# Docker local config
.docker/

# Test coverage
**/coverage/

# Working memory — Claude session notes
SCRATCHPAD.md
docker-compose.override.yml

# Local model weights (GGUF) — hundreds of MB each, never committed.
# models/README.md documents what belongs here and stays tracked.
models/*
!models/README.md

# Credential-shaped strays that were tracked in a PUBLIC repo until the preview
# security baseline removed them. None held a live secret — `neo4j_password.txt`
# and `.env.local` both carried the `docker-compose.yaml` default (`password`),
# which is public in the compose file anyway, and `.env` was empty — but a
# tracked file named like a credential is read as one, and the root-level
# `**/.env` rule below never applied to them because tracking predates it.
neo4j_password.txt
.env.local
