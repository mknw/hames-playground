# Copy to `deploy.local.env` (git-ignored: `deploy/modal/*.local.*`) and fill in.
# Every value in this file is one deployment's own decision and stays with its
# operator (ADR-0008). The tracked app reads these at `modal deploy` time; it
# has no defaults for the two marked required and refuses to deploy without them.
#
#   uv run --env-file deploy.local.env modal deploy hames_small_models.py
#   uv run --env-file deploy.local.env modal deploy hames_private_27b.py

# --- Placement (required) ---------------------------------------------------
# Modal container region for the GPU, and the region of the proxy that fronts
# it. Narrow regions (eu-west, eu-north, eu-south) pin to one area at a 1.75x
# multiplier; the broad `eu` region covers the EEA at 1.15x. Which country backs
# a narrow EU region is not published by Modal; confirm with them before any
# residency sign-off.
HAMES_MODAL_COMPUTE_REGION=
HAMES_MODAL_ROUTING_REGION=

# --- Shape (defaults shown) -------------------------------------------------
# HAMES_MODAL_APP_NAME=hames-small-models
# HAMES_MODAL_GPU=L4
# HAMES_MODAL_CPU=2
# Level-1 sleep offloads the ~9 GB bf16 weights to CPU RAM before the snapshot,
# so the request must hold the weights plus the runtime.
# HAMES_MODAL_MEMORY_MIB=24576
# Seconds the container stays up after its last request. Billed.
# HAMES_MODAL_SCALEDOWN_S=300
# Modal's default is 30s; a first boot loads weights and warms both models.
# HAMES_MODAL_STARTUP_TIMEOUT_S=600
# One replica: a spend cap for a measurement box. Modal notes it blocks
# rolling redeploys (a redeploy waits for the old container to stop).
# HAMES_MODAL_MAX_CONTAINERS=1
# HAMES_MODAL_TARGET_CONCURRENCY=4
# 1 = CPU + GPU memory snapshots with the vLLM sleep/wake sequence (the point
# of using Modal); 0 = plain cold start, for the baseline measurement only.
# HAMES_MODAL_SNAPSHOT=1

# --- The 27B, its own app (hames_private_27b.py; defaults shown) -------------
# The private tier's capable model, what the app's SelfDeployedQwen client reaches. It
# shares the two regions above and the proxy token below.
# HAMES_MODAL_27B_APP_NAME=hames-private-27b
# "H100!" pins an H100; plain "H100" lets Modal substitute an H200, and memory
# snapshots are taken per GPU type. "RTX-PRO-6000" is the 96 GB alternative.
# HAMES_MODAL_27B_GPU=H100!
# HAMES_MODAL_27B_CPU=4
# Level-1 sleep offloads the ~31 GB of weights to CPU RAM before the snapshot.
# HAMES_MODAL_27B_MEMORY_MIB=65536
# Matches the app's LARGE_LLM_SCALEDOWN_SECONDS default; set both together.
# HAMES_MODAL_27B_SCALEDOWN_S=300
# HAMES_MODAL_27B_STARTUP_TIMEOUT_S=1800
# HAMES_MODAL_27B_MAX_CONTAINERS=1
# HAMES_MODAL_27B_TARGET_CONCURRENCY=8
# Draft tokens per step from the model's own multi-token-prediction head; 0 = off.
# HAMES_MODAL_27B_MTP_TOKENS=2

# --- Client side, after deploy (measure.py and the app) ---------------------
# The URL `modal deploy` prints (https://<workspace>--<app>-<class>.<region>.modal.direct).
# HAMES_MODAL_URL=
# A Proxy Token pair joined with a period: wk-....ws-.... Created in Modal's
# dashboard (Settings -> Proxy Tokens). This same value is what the app sends as
# SMALL_LLM_API_KEY; Modal's edge rejects a bad one with 401 before any
# container starts.
# HAMES_MODAL_PROXY_TOKEN=
# The 27B's own URL (what `modal deploy hames_private_27b.py` prints). The app's
# LARGE_LLM_BASE_URL is this plus /v1, LARGE_LLM_API_KEY the token.
# HAMES_MODAL_27B_URL=
