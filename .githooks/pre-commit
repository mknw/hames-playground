#!/bin/sh
# Format and auto-fix STAGED files only (~1s). Deliberately repairs rather than
# rejects: agents commit often, and a hook that blocks mid-run costs more than
# it saves. CI is the real gate.
#
# Enabled by `git config core.hooksPath .githooks`, which ui/'s `prepare`
# script runs on every install.

command -v pnpm >/dev/null 2>&1 || {
  echo "pre-commit: pnpm not on PATH — skipping format/lint (are you in the nix shell?)"
  exit 0
}

cd "$(git rev-parse --show-toplevel)/ui" 2>/dev/null || exit 0
[ -d node_modules ] || { echo "pre-commit: no node_modules — skipping"; exit 0; }

exec pnpm exec lint-staged
