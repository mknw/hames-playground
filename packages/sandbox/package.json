{
  "name": "@hames-ai/sandbox",
  "version": "0.1.0",
  "description": "The containment companion for @hames-ai/harness-patterns — withSandbox, the Docker compute backend, the egress profiles and the bash guard, behind injected host seams.",
  "keywords": [
    "sandbox",
    "docker",
    "containment",
    "egress",
    "agents",
    "harness",
    "typescript"
  ],
  "homepage": "https://github.com/mknw/hames-playground/tree/main/packages/sandbox#readme",
  "bugs": {
    "url": "https://github.com/mknw/hames-playground/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mknw/hames-playground.git",
    "directory": "packages/sandbox"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Accetto",
    "url": "https://github.com/mknw"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./guard": "./bash-guard.ts",
    "./*": "./*.ts"
  },
  "files": [
    "*.ts",
    "!vitest.config.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"const ua=process.env.npm_config_user_agent||'';const ex=process.env.npm_execpath||'';if(ua.startsWith('npm/')||ex.includes('npm-cli'))throw new Error('This package must be published with pnpm publish, not npm: npm does not rewrite workspace: specifiers and ships them literally.')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-pty": "^1.1.0"
  },
  "peerDependencies": {
    "@hames-ai/harness-patterns": "workspace:^"
  },
  "devDependencies": {
    "@hames-ai/harness-baml": "workspace:^",
    "@hames-ai/harness-patterns": "workspace:^",
    "@vitest/coverage-v8": "^4.1.5",
    "vitest": "^4.1.5"
  }
}
