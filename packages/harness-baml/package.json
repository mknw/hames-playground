{
  "name": "@hames/harness-baml",
  "version": "0.1.0",
  "description": "The BAML companion for @hames/harness-patterns — the role→client resolution seam, the adapter factories, and a pre-generated baml_client shipped beside its baml_src so a consumer never runs baml-generate.",
  "keywords": [
    "baml",
    "llm",
    "prompts",
    "inference",
    "harness",
    "patterns",
    "agents"
  ],
  "homepage": "https://github.com/mknw/hames-playground/tree/main/packages/harness-baml#readme",
  "bugs": {
    "url": "https://github.com/mknw/hames-playground/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mknw/hames-playground.git",
    "directory": "packages/harness-baml"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Accetto",
    "url": "https://github.com/mknw"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./clients.server": "./clients.server.ts",
    "./consumer-clients.server": "./consumer-clients.server.ts",
    "./baml-adapters.server": "./baml-adapters.server.ts",
    "./baml_client": "./baml_client/index.ts",
    "./baml_client/*": "./baml_client/*.ts",
    "./*": "./*.ts"
  },
  "files": [
    "*.ts",
    "baml_src",
    "baml_client",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "baml-generate": "baml-cli generate",
    "prepublishOnly": "node -e \"const ua=process.env.npm_config_user_agent||'';const ex=process.env.npm_execpath||'';if(ua.startsWith('npm/')||ex.includes('npm-cli'))throw new Error('This package must be published with pnpm publish, not npm: npm does not rewrite workspace: specifiers and ships them literally.')\""
  },
  "dependencies": {
    "@boundaryml/baml": "0.224.0"
  },
  "peerDependencies": {
    "@hames/harness-patterns": "workspace:^"
  },
  "devDependencies": {
    "@hames/harness-patterns": "workspace:^"
  }
}
