{
  "name": "@hames-ai/connectors",
  "version": "0.1.0",
  "description": "The connectors companion for @hames-ai/harness-patterns — Microsoft Graph app-side tools, the Neo4j non-agentic layer, and the MCP-gateway namespace catalog, all behind injected seams.",
  "keywords": [
    "connectors",
    "neo4j",
    "cypher",
    "graph",
    "mcp",
    "tools",
    "harness"
  ],
  "homepage": "https://github.com/mknw/hames-playground/tree/main/packages/connectors#readme",
  "bugs": {
    "url": "https://github.com/mknw/hames-playground/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mknw/hames-playground.git",
    "directory": "packages/connectors"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Accetto",
    "url": "https://github.com/mknw"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./neo4j": "./neo4j/index.ts",
    "./*": "./*.ts"
  },
  "files": [
    "*.ts",
    "!vitest.config.ts",
    "neo4j",
    "app-tools",
    "graph",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"const ua=process.env.npm_config_user_agent||'';const ex=process.env.npm_execpath||'';if(ua.startsWith('npm/')||ex.includes('npm-cli'))throw new Error('This package must be published with pnpm publish, not npm: npm does not rewrite workspace: specifiers and ships them literally.')\""
  },
  "dependencies": {
    "neo4j-driver": "^6.0.1"
  },
  "peerDependencies": {
    "@hames-ai/harness-patterns": "workspace:^"
  },
  "devDependencies": {
    "@hames-ai/harness-patterns": "workspace:^",
    "seroval": "~1.5.0",
    "vitest": "^4.1.5"
  }
}
